rules_version = '2';

// BizPOS Firestore security rules.
// Shop owners can only see their own shop; only the super admin can change
// plans, features, expiry or block a shop. Paste this file in
// Firebase console > Firestore Database > Rules, or deploy with the Firebase CLI.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super';
    }

    function shopOwner(shopId) {
      return signedIn()
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    // Fields a shop owner may set. Plan, features, expiry and status are admin-only.
    function ownerShopFields() {
      return ['ownerUid', 'ownerEmail', 'name', 'category', 'phone', 'city', 'currency',
              'devices', 'createdAt', 'updatedAt', 'plan', 'status'];
    }

    // Super admins are added by hand in the Firebase console (admins/{uid} with role "super").
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // An admin may update their own security settings but never their role.
      allow update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow create, delete: if false;
    }

    // Branding and app-wide settings: everyone reads, only admins write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Packages are public so the app can show prices; only admins edit them.
    match /packages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'shopId', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'shopId', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /shops/{shopId} {
      // A company the super admin created has ownerUid "" until its owner joins.
      // Anyone holding the company code (document id) may open it to join.
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin() || resource.data.ownerUid == '');
      // Owners find a company created for their verified email.
      allow list: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin()
        || (resource.data.ownerUid == ''
            && request.auth.token.email_verified == true
            && resource.data.ownerEmail == request.auth.token.email));

      // A new shop always starts on the free plan.
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.plan == 'free'
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly(ownerShopFields()));

      allow update: if isAdmin()
        // Joining an unclaimed company: only the owner fields change.
        || (signedIn()
          && resource.data.ownerUid == ''
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'ownerEmail', 'updatedAt']))
        || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status != 'blocked'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'category', 'phone', 'city', 'currency', 'devices', 'stats', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------- online store

    function shopData(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    // The shop may go online on a paid plan, or when the super admin set a limit for it.
    function mayPublish(shopId) {
      return shopData(shopId).plan != 'free' || shopData(shopId).get('onlineLimit', null) != null;
    }

    function ownerStoreWrite(shopId) {
      return signedIn()
        && shopData(shopId).ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.shopId == shopId
        // The plan expiry shown to the website must be the real one.
        && request.resource.data.paidUntil == shopData(shopId).get('expiresAt', 0)
        && (request.resource.data.published == false || mayPublish(shopId));
    }

    // Public store card. adminHidden is set only by the super admin.
    match /storefronts/{shopId} {
      allow get: if true;
      allow list: if isAdmin()
        || (resource.data.published == true && resource.data.adminHidden == false);
      allow create: if isAdmin() || (ownerStoreWrite(shopId) && request.resource.data.adminHidden == false);
      allow update: if isAdmin() || (ownerStoreWrite(shopId) && request.resource.data.adminHidden == resource.data.adminHidden);
      allow delete: if isAdmin();

      // Products shown online.
      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin() || (signedIn() && shopData(shopId).ownerUid == request.auth.uid);
      }
    }

    // Hot products and deals on the website home, picked by the super admin.
    match /featured/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function appSettings() {
      return get(/databases/$(database)/documents/settings/app).data;
    }

    // Orders placed on the website by customers (an account is optional).
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['shopId', 'ownerUid', 'shopName', 'currency', 'items', 'total',
             'customerName', 'customerPhone', 'address', 'note', 'status', 'createdAt',
             'customerUid', 'coinsUsed', 'coinDiscount'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 7
        && request.resource.data.customerPhone.size() <= 20
        && get(/databases/$(database)/documents/storefronts/$(request.resource.data.shopId)).data.published == true
        && get(/databases/$(database)/documents/storefronts/$(request.resource.data.shopId)).data.ownerUid == request.resource.data.ownerUid
        // A signed-in shopper's orders carry their own uid only.
        && (request.resource.data.get('customerUid', '') == ''
            || (request.auth != null && request.resource.data.customerUid == request.auth.uid))
        // Paying with coins: feature on, right value, within the limit, and the
        // shopper's balance goes down by the same coins in the same write.
        && (request.resource.data.get('coinsUsed', 0) == 0
            || (request.auth != null
                && request.resource.data.customerUid == request.auth.uid
                && request.resource.data.coinsUsed is int
                && request.resource.data.coinsUsed > 0
                && appSettings().get('coinsEnabled', false) == true
                && request.resource.data.coinDiscount == request.resource.data.coinsUsed * appSettings().get('coinValue', 0)
                && request.resource.data.coinDiscount <= request.resource.data.total * appSettings().get('coinsMaxPercent', 0) / 100
                && getAfter(/databases/$(database)/documents/shoppers/$(request.auth.uid)).data.get('lastOrder', '') == id));
      // Anyone with the order number can see its status (tracking link).
      allow get: if true;
      allow list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && resource.data.get('customerUid', '') == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'coinsAwarded', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Website shopper accounts with their BizPOS coins.
    match /shoppers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'address', 'email', 'coins', 'createdAt', 'updatedAt'])
        && request.resource.data.coins == 0;
      allow update: if isAdmin()
        // Profile changes.
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'updatedAt']))
        // Spending coins on a new order placed in the same write.
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'lastOrder', 'name', 'phone', 'address', 'updatedAt'])
            && !exists(/databases/$(database)/documents/orders/$(request.resource.data.lastOrder))
            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrder)).data.customerUid == uid
            && request.resource.data.coins == resource.data.coins
                 - getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrder)).data.coinsUsed
            && request.resource.data.coins >= 0)
        // A shop giving coins for a delivered order, recorded in coinAwards in the same write.
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'lastAward'])
            && !exists(/databases/$(database)/documents/coinAwards/$(request.resource.data.lastAward))
            && getAfter(/databases/$(database)/documents/coinAwards/$(request.resource.data.lastAward)).data.uid == uid
            && request.resource.data.coins == resource.data.coins
                 + getAfter(/databases/$(database)/documents/coinAwards/$(request.resource.data.lastAward)).data.coins);
      allow delete: if isAdmin();
    }

    // One coin award per delivered order, given by the shop that got the order.
    match /coinAwards/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && get(/databases/$(database)/documents/orders/$(orderId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.get('customerUid', '') == request.resource.data.uid
        && request.resource.data.uid != ''
        && appSettings().get('coinsEnabled', false) == true
        && request.resource.data.coins is int
        && request.resource.data.coins > 0
        && request.resource.data.coins <= get(/databases/$(database)/documents/orders/$(orderId)).data.total / 100
             * appSettings().get('coinsPerHundred', 0);
      allow update, delete: if isAdmin();
    }

    // Payment and subscription history (one document per payment).
    match /subscriptions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Upgrade requests from shops to the super admin.
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && shopOwner(request.resource.data.shopId);
      allow update, delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
